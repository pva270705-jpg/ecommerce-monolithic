generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  roleid   Int    @id @default(autoincrement())
  rolename String @unique @db.VarChar(50)
  users    User[]
}

model Membership {
  mid   Int    @id @default(autoincrement())
  mname String @unique @db.VarChar(50)
  score Int    @default(0)
  users User[]
}

model User {
  uid        Int        @id @default(autoincrement())
  username   String     @unique @db.VarChar(50)
  fullname   String     @db.VarChar(100)
  password   String     @db.VarChar(255)
  roleid     Int
  mid        Int
  role       Role       @relation(fields: [roleid], references: [roleid], onDelete: Restrict)
  membership Membership @relation(fields: [mid], references: [mid], onDelete: Restrict)
  orders     Order[]
}

model Product {
  pid      Int           @id @default(autoincrement())
  pname    String        @db.VarChar(100)
  price    Decimal       @db.Decimal(10, 2)
  quantity Int           @default(0)
  details  OrderDetail[]
}

model Order {
  oid       Int           @id @default(autoincrement())
  uid       Int
  createat  DateTime      @default(now()) @db.Timestamp(3)
  user      User          @relation(fields: [uid], references: [uid], onDelete: Restrict)
  details   OrderDetail[]
  shipments Shipment[]

  @@index([uid, createat])
}

model OrderDetail {
  oid        Int
  pid        Int
  qty        Int
  unit_price Decimal @db.Decimal(10, 2)
  order      Order   @relation(fields: [oid], references: [oid], onDelete: Cascade)
  product    Product @relation(fields: [pid], references: [pid], onDelete: Restrict)

  @@id([oid, pid])
}

model Shipment {
  shipid Int    @id @default(autoincrement())
  oid    Int
  status String @db.VarChar(50)
  order  Order  @relation(fields: [oid], references: [oid], onDelete: Cascade)

  @@index([oid])
}
